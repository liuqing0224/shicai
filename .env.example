# Local API and web ports
PORT=8897
HOST=127.0.0.1
WEB_PORT=5283

# mock: deterministic local demo; codex: invoke the local Codex CLI
AGENT_PROVIDER=mock
AGENT_TIMEOUT_MINUTES=10
AGENT_CONCURRENCY=1

# Optional overrides
# CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
# LARK_CLI_BIN=/absolute/path/to/lark-cli
# DATA_DIR=/absolute/path/to/project/.data
# FEISHU_TENANT=https://your-company.feishu.cn
# FEISHU_EVALUATION_URL=https://your-company.feishu.cn/hire/application-biz/evaluation/list?activeStatus=1
